---
import { buttonSolidClass } from './buttonClasses';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  'aria-label'?: string;
  disabled?: boolean;
  target?: string;
  rel?: string;
  'data-url'?: string;
}

const {
  href,
  type = 'button',
  class: className = '',
  id,
  'aria-label': ariaLabel,
  disabled = false,
  target,
  rel,
  'data-url': dataUrl,
} = Astro.props;

const classes = [buttonSolidClass, className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} id={id} aria-label={ariaLabel} target={target} rel={rel}>
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      id={id}
      aria-label={ariaLabel}
      disabled={disabled}
      data-url={dataUrl}
    >
      <slot />
    </button>
  )
}
