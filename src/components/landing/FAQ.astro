---
import { faqItemsHome } from "../../data/faq";
import SectionTitle from "../ui/SectionTitle.astro";
import SectionSubtitle from "../ui/SectionSubtitle.astro";
import Section from "../ui/Section.astro";
import Link from "../ui/Link.astro";
---

<Section id="preguntas-frecuentes" bg="white" aria-labelledby="faq-title">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="home-reveal">
      <SectionTitle id="faq-title">Preguntas frecuentes</SectionTitle>
      <SectionSubtitle>
        Respuestas claras sobre apoyo, denuncia y emergencias.
      </SectionSubtitle>
    </div>
    <dl class="space-y-4 lg:space-y-8 mt-8 lg:mt-16">
      {
        faqItemsHome.map((faq, i) => (
          <div
            class="home-reveal rounded-2xl border border-[var(--brand-lilac)] p-4 lg:p-6"
            style={`transition-delay: ${i * 80}ms;`}
          >
            <dt id={faq.id} class="text-lg font-semibold">
              {faq.question}
            </dt>
            <dd class="mt-2" aria-labelledby={faq.id}>
              {faq.answer}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="home-reveal mt-10 flex justify-center" style="transition-delay: 240ms;">
      <Link href="/preguntas-frecuentes">Ver todas las preguntas</Link>
    </div>
  </div>
</Section>
