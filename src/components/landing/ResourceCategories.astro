---
import SectionTitle from "../ui/SectionTitle.astro";
import SectionSubtitle from "../ui/SectionSubtitle.astro";
import Section from "../ui/Section.astro";

// filterType = value used in DirectoryFilters (SUPPORT_TYPES). Multiple for "Organizaciones".
const categories = [
  {
    name: "Líneas de crisis",
    icon: "📞",
    description: "Atención 24 h. Gratuita.",
    filterTypes: ["crisis hotline"],
  },
  {
    name: "Colectivas",
    icon: "👥",
    description: "Redes y colectivas feministas.",
    filterTypes: ["community support"],
  },
  {
    name: "Aborto seguro",
    icon: "🌿",
    description: "Acompañamiento seguro y gratuito.",
    filterTypes: ["abortion accompaniment"],
  },
  {
    name: "Psicólogas",
    icon: "🧠",
    description: "Apoyo psicológico y terapia.",
    filterTypes: ["psychological support"],
  },
  {
    name: "Abogadas",
    icon: "⚖️",
    description: "Asesoría y acompañamiento legal.",
    filterTypes: ["legal support"],
  },
  {
    name: "Organizaciones",
    icon: "🏛",
    description: "ONG y apoyo legal o comunitario.",
    filterTypes: ["legal support", "community support"],
  },
  {
    name: "Recursos gubernamentales",
    icon: "🏢",
    description: "Servicios gratuitos del Estado.",
    filterTypes: ["government services"],
  },
  {
    name: "Nutriólogas",
    icon: "🥗",
    description: "Nutrición y alimentación.",
    filterTypes: ["nutrition support"],
  },
  {
    name: "Médicas y Salud",
    icon: "🩺",
    description: "Salud de la mujer y derecho al cuerpo.",
    filterTypes: ["medical and health", "sexual health"],
  },
  {
    name: "Asociaciones y Fundaciones",
    icon: "🤝",
    description: "Refugios, apoyo legal y psicológico.",
    filterTypes: ["associations and foundations"],
  },
];

function buildDirectorioUrl(filterTypes: string[]): string {
  if (filterTypes.length === 0) return "/directorio";
  const params = new URLSearchParams();
  filterTypes.forEach((t) => params.append("tipo", t));
  return `/directorio?${params.toString()}`;
}
---

<Section id="categorias" bg="lilac" aria-labelledby="categories-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="home-reveal">
      <SectionTitle id="categories-title" color="white">
        Tipos de recursos
      </SectionTitle>
      <SectionSubtitle>
        Explora los diferentes tipos de recursos disponibles en el directorio.
      </SectionSubtitle>
    </div>
    <ul
      class="grid gap-4 lg:gap-8 grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 mt-8 lg:mt-16"
      role="list"
    >
      {
        categories.map((cat, i) => (
          <li
            class="home-reveal category-card h-full"
            style={`transition-delay: ${Math.min(i, 8) * 50}ms;`}
          >
            <a
              href={buildDirectorioUrl(cat.filterTypes)}
              class="flex flex-col rounded-2xl bg-[var(--brand-white)] p-4 lg:p-6 focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] focus:ring-offset-2 h-full"
              style="box-shadow: 0 6px 20px rgba(76, 74, 77, 0.06);"
            >
              <span class="flex justify-start text-3xl" aria-hidden="true">
                {cat.icon}
              </span>
              <h3 class="mt-4 text-lg font-semibold">{cat.name}</h3>
              <p class="mt-2 text-base">{cat.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
