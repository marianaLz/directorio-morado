---
import Dimo from "../../assets/svg/dimo.astro";
import ButtonSolid from "../ui/ButtonSolid.astro";
import ButtonOutline from "../ui/ButtonOutline.astro";
import SectionSubtitle from "../ui/SectionSubtitle.astro";
import Section from "../ui/Section.astro";
---

<Section id="hero" bg="white" aria-labelledby="hero-title">
  <div
    class="mx-auto max-w-4xl px-4 text-center sm:px-6 flex items-center justify-center flex-col"
  >
    <div class="home-fade-up w-full max-w-64 lg:max-w-80 mx-auto">
      <Dimo />
    </div>
    <h1
      id="hero-title"
      class="home-fade-up home-delay-1 text-2xl font-black text-[var(--brand-gray)] lg:text-3xl uppercase tracking-wide mt-4"
    >
      Directorio Morado
    </h1>
    <p
      class="home-fade-up home-delay-2 my-6 text-xl font-bold text-[var(--brand-lilac)] lg:text-2xl"
    >
      Red de apoyo · MX
    </p>
    <div class="home-fade-up home-delay-3">
      <SectionSubtitle class="mt-0">
        Directorio de recursos de apoyo para sobrevivientes de violencia sexual
        en México.
      </SectionSubtitle>
      <SectionSubtitle class="mt-0">
        No estás solx. Hay personas que pueden ayudarte.
      </SectionSubtitle>
    </div>
    <div
      class="home-fade-up home-delay-4 mt-10 flex flex-col gap-4 lg:gap-6 sm:flex-row sm:justify-center"
    >
      <ButtonSolid href="/directorio"> Explorar directorio </ButtonSolid>
      <ButtonOutline href="/sugerir-recurso">
        Sugerir un recurso
      </ButtonOutline>
    </div>
  </div>
</Section>
