---
import ButtonOutline from "./ui/ButtonOutline.astro";

interface Props {
  title?: string;
  text?: string;
  url?: string;
}

const {
  title = "Directorio Morado — Red de apoyo · MX",
  text = "Directorio de recursos de apoyo para sobrevivientes de violencia sexual en México.",
  url,
} = Astro.props;
const shareUrl = url ?? Astro.url.href;
---

<div
  class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between sm:gap-8"
>
  <div class="max-w-xl">
    <p class="text-base font-semibold text-[var(--brand-primary)] lg:text-lg">
      Estás en un espacio seguro
    </p>
    <p class="mt-1 text-sm lg:text-base">
      No recopilamos datos. Sin registro. Nadie sabrá que estuviste aquí.
    </p>
  </div>

  <ButtonOutline
    type="button"
    class="share-native-btn shrink-0 cursor-pointer text-sm"
    aria-label="Compartir directorio"
    data-title={title}
    data-text={text}
    data-url={shareUrl}
  >
    Compartir
  </ButtonOutline>
</div>

<script>
  document.querySelectorAll(".share-native-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = btn as HTMLButtonElement;
      const shareData = {
        title: el.dataset.title ?? document.title,
        text: el.dataset.text ?? "",
        url: el.dataset.url ?? window.location.href,
      };

      const original = "Compartir";
      const setLabel = (label: string) => {
        el.textContent = label;
      };

      try {
        if (typeof navigator.share === "function") {
          await navigator.share(shareData);
          return;
        }

        await navigator.clipboard.writeText(shareData.url);
        setLabel("¡Enlace copiado!");
        el.setAttribute("aria-label", "Enlace copiado al portapapeles");
        setTimeout(() => {
          setLabel(original);
          el.setAttribute("aria-label", "Compartir directorio");
        }, 2000);
      } catch (err) {
        // User cancelled the native share sheet — ignore
        if (err instanceof DOMException && err.name === "AbortError") return;
        setLabel("No se pudo compartir");
        setTimeout(() => setLabel(original), 2000);
      }
    });
  });
</script>
