---
import SEOLayout from "./SEOLayout.astro";
import {
  getBaseUrl,
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildDatasetSchema,
  buildCrisisServiceSchema,
} from "../data/schema";
import EmergencyBanner from "../components/EmergencyBanner.astro";
import ButtonSolid from "../components/ui/ButtonSolid.astro";
import Isotype from "../assets/svg/isotype.astro";
import Dimo from "../assets/svg/dimo.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = "Directorio Morado es una red de apoyo que conecta a sobrevivientes de violencia sexual con psicólogas, organizaciones, colectivas y recursos de ayuda en México y Latinoamérica.",
  canonical,
  image,
  structuredData: pageStructuredData = [],
} = Astro.props;

const baseUrl = getBaseUrl();
const defaultStructuredData = [
  buildWebSiteSchema(baseUrl),
  buildOrganizationSchema(baseUrl),
  buildDatasetSchema(baseUrl),
  buildCrisisServiceSchema(),
];
const allStructuredData = [...defaultStructuredData, ...pageStructuredData];
---

<SEOLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  structuredData={allStructuredData}
>
  <EmergencyBanner />

  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:py-4 sm:px-6"
    aria-label="Navegación"
  >
    <a
      href="/"
      class="text-lg font-semibold min-h-[44px] flex items-center gap-1"
      aria-label="Directorio Morado"
    >
      <Isotype />
    </a>
    <ButtonSolid href="/directorio" class="min-w-[140px]">
      Ver directorio
    </ButtonSolid>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="pt-48 lg:pt-96 pb-8 bg-[var(--brand-primary)]">
    <div
      class="mx-auto max-w-6xl px-4 sm:px-6 space-y-12 text-[var(--brand-white)]"
    >
      <div
        class="flex flex-col lg:flex-row gap-12 lg:items-center justify-between"
      >
        <div class="leading-[2] text-base" role="note" aria-label="Privacidad">
          <p class="font-semibold">Estás en un espacio seguro</p>
          <p>No recopilamos datos.</p>
          <p>Sin registro.</p>
          <p>Nadie sabrá que estuviste aquí.</p>
        </div>

        <div class="w-full max-w-lg">
          <Dimo color="var(--brand-white)" />
        </div>
      </div>

      <div>
        <nav
          class="pt-10 border-t border-white/10 flex gap-2 flex-wrap"
          aria-label="Enlaces internos"
        >
          <a href="/" class="text-sm font-medium underline"> Inicio </a>
          <span class="text-brand-white/50 mx-2" aria-hidden="true">·</span>
          <a href="/directorio" class="text-sm font-medium underline">
            Ver directorio completo
          </a>
          <span class="text-brand-white/50 mx-2" aria-hidden="true">·</span>
          <a href="/sugerir-recurso" class="text-sm font-medium underline">
            Sugerir un recurso
          </a>
          <span class="text-brand-white/50 mx-2" aria-hidden="true">·</span>
          <a href="/preguntas-frecuentes" class="text-sm font-medium underline">
            Preguntas frecuentes
          </a>
        </nav>
      </div>
    </div>
  </footer>
</SEOLayout>
