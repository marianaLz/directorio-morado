---
import Layout from "../layouts/Layout.astro";
import ShareButtons from "../components/ShareButtons.astro";
import DirectoryFromFirestore from "../components/directory/DirectoryFromFirestore";
import BackToTop from "../components/directory/BackToTop";
import SectionTitle from "../components/ui/SectionTitle.astro";
import SectionSubtitle from "../components/ui/SectionSubtitle.astro";
import directoryExport from "../../public/directory.json";
import type { DirectoryEntry } from "../types/directory";
import { getBaseUrl, buildDirectoryEntrySchema } from "../data/schema";
import Section from "../components/ui/Section.astro";

// Structured data / LD+JSON desde export de Firestore (generado en build por export-from-firestore.mjs)
const entriesForSchema = directoryExport as DirectoryEntry[];
const baseUrl = getBaseUrl();
const directoryStructuredData = entriesForSchema.map((entry) =>
  buildDirectoryEntrySchema(
    entry as import("../data/schema").DirectoryEntryForSchema,
    baseUrl,
  ),
);
---

<Layout
  title="Directorio de apoyo"
  description="Directorio Morado es una red de apoyo que conecta a sobrevivientes de violencia sexual con organizaciones, psicólogas, colectivas y recursos en México y Latinoamérica."
  structuredData={directoryStructuredData}
>
  <Section>
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <header class="mb-8 lg:mb-16">
        <SectionTitle as="h1">Directorio de apoyo</SectionTitle>
        <SectionSubtitle class="mb-4 lg:mb-8">
          Red de apoyo · MX. Hay personas que pueden ayudarte.
        </SectionSubtitle>

        <ShareButtons
          title="Directorio Morado — Red de apoyo · MX"
          url={`${baseUrl}/directorio`}
        />
      </header>

      <DirectoryFromFirestore client:load />
      <BackToTop client:load />
    </div>
  </Section>
</Layout>
